# Neon Postgres connection string -- from your Neon project dashboard
# (Dashboard -> Connection Details -> "Pooled connection")
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# HMAC signing secret for session JWTs -- generate a strong random value per environment
SESSION_SECRET="replace-with-a-long-random-string"

# ============================================================================
# EMAIL (Gmail SMTP via Nodemailer)
# ============================================================================
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate an "App Password" (select "Mail" + "Other")
# 5. Copy the 16-character password and paste it below as SMTP_PASS

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="your-email@gmail.com"

# ============================================================================
# ROUTE PLANNING & OPTIMIZATION (open-source, no API keys required)
# ============================================================================

# OSRM routing engine -- used for distance matrices and pickup-order solving.
# Defaults to the public demo server. For production, self-host OSRM
# (https://github.com/Project-OSRM/osrm-backend) over your own map extract and
# point OSRM_SERVER_URL at it, e.g.:
#   OSRM_SERVER_URL="https://routing.your-company.com"
OSRM_SERVER_URL="https://router.project-osrm.org"

# OpenStreetMap geocoding (Nominatim).
# Free for light use with a descriptive User-Agent. For production, self-host a
# Nominatim instance and point GEOCODER_URL at it.
#   GEOCODER_URL="https://nominatim.your-company.com"
GEOCODER_URL="https://nominatim.openstreetmap.org"
GEOCODER_USER_AGENT="transport-portal/1.0 (your-company ops)"
GEOCODER_COUNTRY_CODES="bd"

# Office Location Coordinates (Dhaka example)
# Used as the starting point for all vehicle routes
OFFICE_LATITUDE="23.8103"
OFFICE_LONGITUDE="90.4125"

# Vehicle Rest Period (in minutes)
# Time vehicles rest between shifts (e.g., between 10 PM and 12 AM runs)
VEHICLE_REST_PERIOD_MINUTES="45"

# Route Generation Timing
# Cron format for when to automatically generate routes (Sunday at 00:01)
ROUTE_GENERATION_CRON="0 1 * * 0"

# Shift Departure Times (HH:mm format)
# When vehicles depart the office for each shift
SHIFT_10PM_DEPARTURE_TIME="20:00"
SHIFT_11PM_DEPARTURE_TIME="20:45"
SHIFT_12AM_PLUS_DEPARTURE_TIME="21:30"

# Capacity Limits
# Maximum employees per vehicle for each shift
SHIFT_10PM_CAPACITY="999"      # No limit (preset sequences)
SHIFT_11PM_CAPACITY="5"         # Max 5 for 11 PM
SHIFT_12AM_PLUS_CAPACITY="5"    # Max 5 for 12 AM-6 AM
