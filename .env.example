# ============================================================================
# REQUIRED
# ============================================================================

# Neon Postgres — pooled connection string (Dashboard → Connection Details →
# "Pooled connection"). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# Direct (un-pooled) connection string — only Prisma Migrate uses it, because
# PgBouncer's transaction pooling cannot hold Migrate's advisory lock.
# If omitted, the CLI falls back to DATABASE_URL (see prisma.config.ts).
DIRECT_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# HMAC signing key for session JWTs — long random string, UNIQUE per environment
# (generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())").
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the portal, used in emailed links (password reset).
# Required in production; defaults to http://localhost:3000 in development.
APP_URL="http://localhost:3000"

# ============================================================================
# EMAIL (Gmail SMTP via Nodemailer) — only sends when NODE_ENV=production.
# Locally, mail is skipped and logged instead.
# ============================================================================
# 1. https://myaccount.google.com/security → enable 2-Step Verification
# 2. https://myaccount.google.com/apppasswords → create an "App Password"
# 3. Paste the 16-character password below as SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="your-email@gmail.com"

# ============================================================================
# ROUTE PLANNING & GEOCODING (open source, no API keys)
# ============================================================================

# OSRM routing engine — distance matrices and pickup-order solving.
# Defaults to the public demo server. For production, self-host OSRM
# (https://github.com/Project-OSRM/osrm-backend) on your own map extract and
# point this at it; a non-default value also lifts the request throttle.
OSRM_SERVER_URL="https://router.project-osrm.org"

# OpenStreetMap geocoding (Nominatim). Free for light use with a descriptive
# User-Agent; self-host for production volume.
GEOCODER_URL="https://nominatim.openstreetmap.org"
GEOCODER_USER_AGENT="transport-portal/1.0 (your-company ops)"
GEOCODER_COUNTRY_CODES="bd"

# ============================================================================
# NOTIFICATIONS (optional — sane defaults when unset)
# ============================================================================

# Sent an alert when an employee submits an ad-hoc request or changes profile
# details. Unset = that alert is skipped.
FACILITIES_NOTIFICATION_EMAIL=""
OPERATIONS_NOTIFICATION_EMAIL=""

# Optional: debug/info/warn/error (defaults: debug in dev, info in production)
# LOG_LEVEL="info"

