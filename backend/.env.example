# ------------------------------------------------------------------
# Transportation Management Portal — backend environment
# Copy to .env and adjust. NEVER commit the real .env.
# ------------------------------------------------------------------

# Database — SQLite for local dev (async via aiosqlite).
# To switch to PostgreSQL in prod, change to e.g.:
#   postgresql+asyncpg://user:pass@host:5432/transport
DATABASE_URL=sqlite+aiosqlite:///./transport.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset token lifetime (minutes)
RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (used in emails + CORS)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Email (SMTP). In dev, leave MAIL_SUPPRESS_SEND=1 to log emails to
# the console instead of sending. Set to 0 and fill SMTP_* in prod.
# ------------------------------------------------------------------
MAIL_SUPPRESS_SEND=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@transport.local
SMTP_FROM_NAME=Transport Portal
SMTP_STARTTLS=1
SMTP_SSL_TLS=0

# Timezone for deadline logic
TIMEZONE=Asia/Dhaka

# Allowed office arrival slots (comma-separated HH:MM)
ARRIVAL_SLOTS=10:00,11:00,12:00

# Weekly submission deadline (day-of-week + time, Asia/Dhaka).
# 5 = Saturday (Mon=0). Schedules for next week close at this moment.
WEEKLY_DEADLINE_WEEKDAY=5
WEEKLY_DEADLINE_HOUR=12
WEEKLY_DEADLINE_MINUTE=0
